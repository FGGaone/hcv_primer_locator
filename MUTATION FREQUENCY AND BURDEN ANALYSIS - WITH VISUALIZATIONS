shared_unique_summary <- data.frame(
  ORF = character(),
  Category = character(),
  Anti_HBc_Status = character(),
  Mutations = character(),
  Count = numeric(),
  stringsAsFactors = FALSE
)

for (orf_name in names(orf_columns)) {
  col_name <- orf_columns[[orf_name]]
  
  mutations_by_status_orf <- list()
  
  for (status_code in c(0, 1, 2)) {
    status_label <- status_labels[[as.character(status_code)]]
    status_data <- df %>% filter(anti_hbc_status == status_code)
    
    if (nrow(status_data) > 0) {
      all_mutations <- unique(unlist(lapply(status_data[[col_name]], parse_mutations)))
      mutations_by_status_orf[[status_label]] <- all_mutations
    }
  }
  
  status_names <- names(mutations_by_status_orf)
  
  if (length(status_names) > 0) {
    for (status_label in status_names) {
      mutations_status <- mutations_by_status_orf[[status_label]]
      other_mutations <- Reduce(union, mutations_by_status_orf[names(mutations_by_status_orf) != status_label])
      unique_muts <- setdiff(mutations_status, other_mutations)
      
      if (length(unique_muts) > 0) {
        shared_unique_summary <- rbind(shared_unique_summary, data.frame(
          ORF = toupper(orf_name),
          Category = paste("Unique to", status_label),
          Anti_HBc_Status = status_label,
          Mutations = paste(unique_muts, collapse = "; "),
          Count = length(unique_muts),
          stringsAsFactors = FALSE
        ))
      }
    }
    
    if (length(status_names) == 3) {
      shared_all <- Reduce(intersect, mutations_by_status_orf)
      if (length(shared_all) > 0) {
        shared_unique_summary <- rbind(shared_unique_summary, data.frame(
          ORF = toupper(orf_name),
          Category = "Shared by ALL",
          Anti_HBc_Status = "All",
          Mutations = paste(shared_all, collapse = "; "),
          Count = length(shared_all),
          stringsAsFactors = FALSE
        ))
      }
    }
  }
}

